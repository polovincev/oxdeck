{
  "name": "oxdeck",
  "productName": "OxDeck",
  "version": "1.4.0",
  "description": "OxDeck — персональная программируемая панель от OxLab",
  "main": "build/electron/main.js",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "start": "pnpm build && electron .",
    "dev": "pnpm build:native && pnpm build:electron && node --experimental-strip-types dev.mts",
    "build": "pnpm build:native && pnpm build:electron && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:native": "node --experimental-strip-types scripts/build-native.mts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --flag unstable_native_nodejs_ts_config . --max-warnings 0 && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config . --max-warnings 0 --fix && stylelint \"src/**/*.css\" --fix && prettier . --write",
    "check": "pnpm lint && pnpm format:check && tsc -p tsconfig.json && tsc -p tsconfig.node.json && pnpm build:electron && node --test build/electron/window-layout.test.js build/electron/kubernetes.test.js build/electron/rewrite.test.js build/shared/layout.test.js build/shared/kubernetes.test.js && pnpm build",
    "package": "pnpm package:arm64",
    "package:arm64": "pnpm build && electron-packager . \"OxDeck\" --platform=darwin --arch=arm64 --out=out --overwrite --asar --app-bundle-id=dev.oxlab.oxdeck --icon=assets/oxdeck.icns --ignore=^/out$",
    "package:x64": "pnpm build && electron-packager . \"OxDeck\" --platform=darwin --arch=x64 --out=out --overwrite --asar --app-bundle-id=dev.oxlab.oxdeck --icon=assets/oxdeck.icns --ignore=^/out$",
    "make": "pnpm make:arm64",
    "make:arm64": "pnpm package:arm64 && mkdir -p out/releases && ditto -c -k --sequesterRsrc --keepParent \"out/OxDeck-darwin-arm64/OxDeck.app\" \"out/releases/OxDeck-v${npm_package_version}-arm64.zip\"",
    "make:x64": "pnpm package:x64 && mkdir -p out/releases && ditto -c -k --sequesterRsrc --keepParent \"out/OxDeck-darwin-x64/OxDeck.app\" \"out/releases/OxDeck-v${npm_package_version}-x64.zip\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polovincev/oxdeck.git"
  },
  "homepage": "https://github.com/polovincev/oxdeck#readme",
  "bugs": {
    "url": "https://github.com/polovincev/oxdeck/issues"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "electron": "^44.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.10"
  }
}
